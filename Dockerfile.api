FROM node:22-alpine AS base

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM deps AS builder
WORKDIR /app
COPY tsconfig.json ./tsconfig.json
COPY lib/db ./lib/db
COPY lib/questions ./lib/questions
COPY lib/taxonomies ./lib/taxonomies
COPY services/api/tsconfig.json ./services/api/tsconfig.json
COPY services/api/src ./services/api/src
RUN ./node_modules/.bin/tsc -p services/api/tsconfig.json

FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 papirar

COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/services/api/dist ./dist

USER papirar

EXPOSE 3001

CMD ["node", "dist/services/api/src/server.js"]
